# Copy to backend/.env and fill in. NEVER commit backend/.env (it is git-ignored).
# Real values are shared privately by the project owner, not through GitHub.

# --- Database ---------------------------------------------------------------
# Supabase runtime connection: Supabase dashboard -> Connect -> Transaction pooler
# (port 6543). Scheme must be postgresql+psycopg:// and special characters in the
# password must be URL-encoded.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Only for explicit migrations (Session pooler, port 5432). Leave empty otherwise.
MIGRATION_DATABASE_URL=
# Schema changes are explicit operations; keep false for Supabase.
AUTO_CREATE_TABLES=false
# Local SQLite fallback (legacy demo data only):
# DATABASE_URL=sqlite:///./sleep_quality_dev.db

# --- Supabase Auth (public project values) -----------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public "anon"/publishable key only. NEVER the service-role/secret key.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Server-side participant grants: Supabase Auth user id (UUID) -> allowed participant codes.
# Example: AUTH_PARTICIPANT_ACCESS={"00000000-0000-0000-0000-000000000000":["P001"]}
AUTH_PARTICIPANT_ACCESS={}

# --- Application ---------------------------------------------------------------
PARTICIPANT_CODE=P001
STUDY_START_DATE=2026-09-24
STUDY_TIMEZONE=Europe/Amsterdam
STUDY_DAYS=14
CALCULATION_VERSION=1
DATA_MODE=demo
MAX_IMPORT_SIZE_MB=10
FRONTEND_ORIGIN=http://127.0.0.1:5173
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Legacy placeholders (not used by the participant dashboard)
SECRET_KEY=change-this-to-a-random-secret-key-for-local-dev
TOKEN_ENCRYPTION_KEY=change-this-32-byte-encryption-key-0000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_PROJECT_ID=your-google-project-id

# --- Access policy (default-deny) -------------------------------------------
# Leave these as shown for normal use with Supabase sign-in.
APP_ENV=
DEV_ANONYMOUS_ACCESS=false
APP_BIND_HOST=
AUTH_ADMIN_USERS=[]
ALLOW_LEGACY_WRITES=false
# auto = legacy study pages need the COMPLETE legacy schema; false = always off.
LEGACY_STUDY_ENABLED=auto
# A run still "running" after this many seconds is failed automatically.
INGESTION_LOCK_TIMEOUT_SECONDS=900
