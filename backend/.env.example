DATABASE_URL=postgresql+psycopg://sleep_user:sleep_password@localhost:5432/sleep_quality
# Supabase runtime: copy the Transaction pooler URI from Connect (port 6543).
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Migrations: use the Session pooler URI (port 5432) from Connect.
MIGRATION_DATABASE_URL=
AUTO_CREATE_TABLES=false
# Fallback for local dev without Postgres: DATABASE_URL=sqlite:///./sleep_quality.db

STUDY_START_DATE=2026-09-24
STUDY_TIMEZONE=Europe/Amsterdam
STUDY_DAYS=14
CALCULATION_VERSION=1

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_PROJECT_ID=your-google-project-id

FRONTEND_ORIGIN=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SECRET_KEY=change-this-to-a-random-secret-key-for-local-dev
TOKEN_ENCRYPTION_KEY=change-this-32-byte-encryption-key-0000

DATA_MODE=demo
PARTICIPANT_CODE=P001

MAX_IMPORT_SIZE_MB=10

# Supabase Auth is mandatory on Vercel. Map each invited user's Auth UUID to
# the participant codes they may access. Keep this grant mapping server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
AUTH_PARTICIPANT_ACCESS={}
