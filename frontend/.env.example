# Copy to frontend/.env.local and fill in. NEVER commit .env.local (it is git-ignored).
# Real values are shared privately by the project owner, not through GitHub.
# Only PUBLIC values belong here: never a database URL or service-role/secret key.

# Supabase project URL and public anon/publishable key (same project as the backend).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Local development uses the Vite proxy (/api -> http://127.0.0.1:8000); leave unset.
# For a separately hosted API: VITE_API_BASE_URL=https://YOUR-BACKEND.example.com/api/v1

# Optional password recovery settings. The redirect URL must be listed under
# Supabase -> Authentication -> URL Configuration -> Redirect URLs.
# VITE_PASSWORD_RECOVERY_REDIRECT_URL=http://127.0.0.1:5173/reset-password
# VITE_PASSWORD_MIN_LENGTH=8
